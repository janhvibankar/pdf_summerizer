# ==============================================================================
# PRANPAN CLIENT CONFIGURATION
# Copy this file to .env in the client/ directory for local development:
#   cp .env.example .env
#
# SECURITY NOTICE:
# In Vite, variables prefixed with VITE_ are embedded into the public JavaScript
# bundle during build. NEVER define database credentials (MONGO_URI), session
# secrets (JWT_SECRET), or AI API keys (GEMINI_API_KEY) here!
# ==============================================================================

# Backend API Base URL
# - Local development default: http://localhost:5000/api
# - Vercel production deployment: https://<your-render-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api


