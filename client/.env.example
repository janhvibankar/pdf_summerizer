# ==============================================================================
# PRANPAN CLIENT CONFIGURATION (PHASE 0)
# Copy this file to .env in the client/ directory:
#   cp .env.example .env
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put database credentials or Gemini API keys here!
# ==============================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

