# ==============================================================================
# PRANPAN MONOREPO ENVIRONMENT OVERVIEW
# ==============================================================================
# PRANPAN maintains strictly separated environment configurations for client & server:
#
# 1. Backend environment file: server/.env
#    Copy from server/.env.example:
#      cp server/.env.example server/.env
#
#    Key variables:
#      NODE_ENV=development
#      PORT=5000
#      CLIENT_ORIGIN=http://localhost:5173
#      MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pranpan?retryWrites=true&w=majority
#      JWT_SECRET=your_jwt_secret_min_32_chars
#      COOKIE_SAME_SITE=lax
#      GEMINI_API_KEY=your_gemini_api_key_placeholder
#      GEMINI_MODEL=gemini-3.5-flash
#      FILE_STORAGE_PROVIDER=local
#      UPLOADS_DIR=
#
# 2. Frontend environment file: client/.env
#    Copy from client/.env.example:
#      cp client/.env.example client/.env
#
#    Key variables:
#      VITE_API_URL=http://localhost:5000/api
#
# SECURITY NOTICE:
# NEVER commit .env files to version control! Only .env.example files are tracked.
# For full production deployment instructions, see DEPLOYMENT.md.
# ==============================================================================

