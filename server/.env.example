# ==============================================================================
# PRANPAN SERVER CONFIGURATION
# Copy this file to .env in the server/ directory for local development:
#   cp .env.example .env
# For Render deployment, configure these key-value pairs in Render Environment Variables.
# ==============================================================================

# Application Runtime
# - Development: NODE_ENV=development, PORT=5000
# - Render Production: NODE_ENV=production, PORT=10000 (Render automatically provides PORT)
NODE_ENV=development
PORT=5000

# Client Application URL (CORS & CSRF origin validation)
# - Development: http://localhost:5173
# - Production: https://<your-app>.vercel.app (supports comma-separated origins if using multiple domains)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Required for user persistence, session authentication, and document metadata.
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/pranpan?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pranpan?retryWrites=true&w=majority

# JWT Authentication & Cookie Security
# In production, JWT_SECRET MUST be a cryptographically random string >= 32 characters.
# Generate on Linux/Mac: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=7d

# Cross-Site Cookie Policy (SameSite)
# - Development: lax (HTTP localhost)
# - Production (Vercel client + Render server): none (required for cross-site authenticated cookies over HTTPS)
COOKIE_SAME_SITE=lax

# Google Gemini API Configuration (Backend Only)
# Get your API key from https://aistudio.google.com/app/apikey
# NEVER commit your key or expose it to client code.
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.5-flash

# PDF Processing & Ingestion Limits
MAX_PDF_SIZE_MB=15
MAX_PDF_PAGES=100

# File Storage Configuration
# - 'local': Files stored on server filesystem.
#   NOTE: Render free tier filesystem is ephemeral; files are lost on dyno restart/redeploy.
# - 'cloudinary': Cloud object storage for persistent private PDF storage.
FILE_STORAGE_PROVIDER=local

# Optional Render Persistent Disk mount path (e.g. /var/data/uploads)
# When set, local storage persists files to the attached disk across redeploys.
UPLOADS_DIR=

# Cloudinary Credentials (Required only if FILE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
