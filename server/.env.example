# ==============================================================================
# PRANPAN SERVER CONFIGURATION (PHASE 2 - AUTHENTICATION & DATABASE)
# Copy this file to .env in the server/ directory:
#   cp .env.example .env
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS validation and cookie origin matching)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Required for user persistence, session management, and document storage.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pranpan?retryWrites=true&w=majority

# JWT Authentication & Cookie Security (Phase 2)
# Must be at least 32 characters in production.
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# RESERVED FOR FUTURE PHASES (DO NOT POPULATE IN CLIENT CODE)
# ------------------------------------------------------------------------------
# Gemini API Key (Phase 3 - Summarization & Chat)
GEMINI_API_KEY=your_gemini_api_key_placeholder
