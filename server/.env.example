# ==============================================================================
# PRANPAN SERVER CONFIGURATION (PHASE 0)
# Copy this file to .env in the server/ directory:
#   cp .env.example .env
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS validation)
# Supports comma-separated list of origins if multiple are needed:
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Optional during Phase 0 local bootstrap: if omitted, server operates gracefully in disconnected mode.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pranpan?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# RESERVED FOR FUTURE PHASES (DO NOT POPULATE IN CLIENT CODE)
# ------------------------------------------------------------------------------
# Gemini API Key (Phase 1)
GEMINI_API_KEY=your_gemini_api_key_placeholder

# JWT Secret & Expiration (Phase 2 - Authentication)
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=7d

