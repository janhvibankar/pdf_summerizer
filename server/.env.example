# ==============================================================================
# PRANPAN SERVER CONFIGURATION (PHASE 3 - PDF PROCESSING & GEMINI AI)
# Copy this file to .env in the server/ directory:
#   cp .env.example .env
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS validation and cookie origin matching)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Required for user persistence, session management, and document storage.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pranpan?retryWrites=true&w=majority

# JWT Authentication & Cookie Security
# Must be at least 32 characters in production.
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration (Phase 3)
# Backend-only API key. Never expose in frontend code.
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.8-flash

# PDF Processing & Ingestion Limits
MAX_PDF_SIZE_MB=15
MAX_PDF_PAGES=100

# File Storage Provider: 'local' (development) or 'cloudinary' (cloud)
FILE_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
